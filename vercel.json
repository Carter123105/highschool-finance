{
    "$schema": "https://openapi.vercel.sh/vercel.json",

    "buildCommand": "npm run build",
    "outputDirectory": "public",

    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },

    "routes": [
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/public/$1"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}