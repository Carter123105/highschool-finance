APP_NAME="School Finance System"
APP_ENV=local
APP_KEY=base64:TI4euPMeU1fLjR27gehkgI1qTNVCN4/VT/tLEb+ndXU=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =========================
# LOGGING
# =========================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =========================
# DATABASE
# =========================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=highschool_finance
DB_USERNAME=root
DB_PASSWORD=

# =========================
# SESSION (SAFE - FILE ONLY)
# =========================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =========================
# CACHE (SAFE - FILE ONLY)
# =========================
CACHE_STORE=file
CACHE_PREFIX=

# =========================
# QUEUE (NO BACKGROUND BLOCKING)
# =========================
QUEUE_CONNECTION=sync

# =========================
# FILESYSTEM
# =========================
FILESYSTEM_DISK=local

# =========================
# BROADCAST
# =========================
BROADCAST_CONNECTION=log

# =========================
# MAIL (SAFE FOR LOCAL DEV)
# =========================
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# =========================
# REDIS (IGNORED LOCALLY BUT OK)
# =========================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================
# VITE
# =========================
VITE_APP_NAME="${APP_NAME}"